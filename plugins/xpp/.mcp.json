{
  "mcpServers": {
    "dynamics-xpp": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project", "${CLAUDE_PLUGIN_ROOT}/src/XppService.Mcp/XppService.Mcp.csproj",
        "-c", "Release",
        "--no-launch-profile",
        "--verbosity", "quiet"
      ]
    },
    "axdb-sql": {
      "type": "stdio",
      "command": "dnx",
      "args": ["Methodify.SqlMcp", "--yes"],
      "env": {
        "CONNECTION_STRING": "Server=(local);Database=AxDB;Trusted_Connection=True;TrustServerCertificate=True"
      }
    }
  }
}
