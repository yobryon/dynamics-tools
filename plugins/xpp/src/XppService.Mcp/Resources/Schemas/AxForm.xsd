      <xs:element name="AllowCreate" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AllowDelete" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AllowEdit" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AutoNotify" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AutoQuery" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AutoSearch" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="CounterField" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="CrossCompanyAutoQuery" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DelayActive" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Index" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="InsertAtEnd" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="InsertIfEmpty" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="JoinSource" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="LinkType" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="OnlyFetchActive" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="OptionalRecordMode" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="StartPosition" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ValidTimeStateAutoQuery" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ValidTimeStateUpdate" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Fields" type="FieldsType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ReferencedDataSources" type="ReferencedDataSourcesType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSourceLinks" type="DataSourceLinksType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DerivedDataSources" type="DerivedDataSourcesType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="JoinRelation" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSourceQuery" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="CopyCallerQuery" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSourceRelation" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSourceChangeGroupMode" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="MaxAccessRight" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="MaxRecordsToLoad" type="xs:integer" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Methods" type="MethodsType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Fields container type -->
  <xs:complexType name="FieldsType">
    <xs:sequence>
      <xs:element name="AxFormDataSourceField" type="AxFormDataSourceFieldType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Field" type="FieldType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Field type (for legacy compatibility) -->
  <xs:complexType name="FieldType">
    <xs:sequence>
      <xs:element name="DataField" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Methods" type="MethodsType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- AxFormDataSourceField complex type -->
  <xs:complexType name="AxFormDataSourceFieldType">
