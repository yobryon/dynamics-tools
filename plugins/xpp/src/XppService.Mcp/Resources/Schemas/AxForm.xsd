      <xs:element name="ShowDeleteButton" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ShowNewButton" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="StatusBarStyle" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Style" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="TitleDataSource" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="TopMargin" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="UseCaptionFromMenuItem" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ViewEditMode" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Visible" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="WindowResize" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="WindowType" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="WorkflowDataSource" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="WorkflowEnabled" type="YesNoType" minOccurs="0" maxOccurs="1"/>
