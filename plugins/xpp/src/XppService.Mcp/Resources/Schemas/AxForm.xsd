  <!-- Controls container type -->
  <xs:complexType name="ControlsType">
    <xs:sequence>
      <xs:element ref="AxFormControlGroup" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Substitution group for all control types -->
  <xs:element name="AxFormControlGroup" abstract="true" type="AxFormControlType"/>

  <!-- Base AxFormControl complex type - comprehensive list -->
  <xs:complexType name="AxFormControlType">
    <xs:sequence>
      <!-- Allow Methods to appear before Name for compatibility -->
      <xs:choice minOccurs="0" maxOccurs="2">
        <xs:element name="Methods" type="MethodsType"/>
        <xs:element name="Name" type="xs:string"/>
      </xs:choice>
      
      <!-- Common properties -->
      <xs:element name="Type" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ElementPosition" type="xs:integer" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ExtendedStyle" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="FilterExpression" type="xs:string" minOccurs="0" maxOccurs="1"/>
      
