      <xs:element name="AllowUserSetup" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AlternateRowShading" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ArrangeMethod" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AutoDeclaration" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="BackgroundColor" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="BackStyle" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Bold" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Border" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="BottomMargin" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ButtonDisplay" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="CacheDataMethod" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ChangeCase" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ColorScheme" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Columns" type="xs:integer" minOccurs="0" maxOccurs="1"/>
