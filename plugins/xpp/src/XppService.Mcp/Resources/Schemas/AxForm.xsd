      <xs:element name="AxFormDataSourceRootLink" type="AxFormDataSourceRootLinkType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- AxFormDataSourceRootLink complex type -->
  <xs:complexType name="AxFormDataSourceRootLinkType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DerivedDataSources type -->
  <xs:complexType name="DerivedDataSourcesType">
    <xs:sequence>
      <xs:element name="AxFormDataSourceDerived" type="AxFormDataSourceDerivedType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- AxFormDataSourceDerived complex type -->
  <xs:complexType name="AxFormDataSourceDerivedType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Table" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSource" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Fields" type="FieldsType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DerivedDataSources" type="DerivedDataSourcesType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ReferencedDataSources" type="ReferencedDataSourcesType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Design complex type -->
  <xs:complexType name="DesignType">
    <xs:sequence>
      <xs:element name="AllowUserSetup" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ArrangeMethod" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="BackgroundColor" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Caption" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ColorScheme" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ColumnsMode" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSource" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DialogSize" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Frame" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="HelpText" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="HideIfEmpty" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="HideToolbar" type="YesNoType" minOccurs="0" maxOccurs="1"/>
