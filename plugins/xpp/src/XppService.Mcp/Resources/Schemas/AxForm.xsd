<?xml version="1.0" encoding="utf-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    elementFormDefault="qualified">

  <!-- Root element -->
  <xs:element name="AxForm" type="AxFormType"/>

  <!-- AxForm complex type -->
  <xs:complexType name="AxFormType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="SourceCode" type="FormSourceCodeType" minOccurs="1" maxOccurs="1"/>
      <xs:element name="DataSources" type="DataSourcesType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Design" type="DesignType" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Parts" type="PartsType" minOccurs="0" maxOccurs="1"/>
      <!-- Added missing elements from validation report -->
      <xs:element name="AllowPreLoading" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSourceChangeGroupMode" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSourceQuery" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="FormTemplate" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="InteractionClass" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="IsObsolete" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Tags" type="xs:string" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- FormSourceCode complex type -->
  <xs:complexType name="FormSourceCodeType">
    <xs:sequence>
      <xs:element name="Methods" type="MethodsType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSources" type="DataSourcesType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataControls" type="DataControlsType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Members" type="xs:string" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DataControls container type -->
  <xs:complexType name="DataControlsType">
    <xs:sequence>
      <xs:element name="Control" type="ControlType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Control complex type -->
  <xs:complexType name="ControlType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Type" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Methods" type="MethodsType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Methods container type -->
  <xs:complexType name="MethodsType">
    <xs:sequence>
      <xs:element name="Method" type="MethodType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="AxMethod" type="AxMethodType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Method complex type -->
  <xs:complexType name="MethodType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Source" type="xs:string" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- AxMethod complex type -->
  <xs:complexType name="AxMethodType">
    <xs:all>
      <xs:element name="Name" type="xs:string" minOccurs="0"/>
      <xs:element name="Source" type="xs:string" minOccurs="0"/>
      <xs:element name="Attributes" type="xs:string" minOccurs="0"/>
      <xs:element name="EventHandlers" type="xs:string" minOccurs="0"/>
      <xs:element name="IsAbstract" type="YesNoType" minOccurs="0"/>
      <xs:element name="IsDelegate" type="YesNoType" minOccurs="0"/>
      <xs:element name="IsDisplay" type="YesNoType" minOccurs="0"/>
      <xs:element name="IsEdit" type="YesNoType" minOccurs="0"/>
      <xs:element name="IsExtendedMethod" type="YesNoType" minOccurs="0"/>
      <xs:element name="IsFinal" type="YesNoType" minOccurs="0"/>
      <xs:element name="IsStatic" type="YesNoType" minOccurs="0"/>
      <xs:element name="Parameters" type="xs:string" minOccurs="0"/>
      <xs:element name="ReturnType" type="xs:string" minOccurs="0"/>
      <xs:element name="Tags" type="xs:string" minOccurs="0"/>
      <xs:element name="TypeParameters" type="xs:string" minOccurs="0"/>
      <xs:element name="Variables" type="xs:string" minOccurs="0"/>
      <xs:element name="Visibility" type="xs:string" minOccurs="0"/>
      <xs:element name="XMLDocumentation" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- DataSources container type -->
  <xs:complexType name="DataSourcesType">
    <xs:sequence>
      <xs:element name="AxFormDataSource" type="AxFormDataSourceType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="DataSource" type="DataSourceType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DataSource type (for legacy compatibility) -->
  <xs:complexType name="DataSourceType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Methods" type="MethodsType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Fields" type="FieldsType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- AxFormDataSource complex type -->
