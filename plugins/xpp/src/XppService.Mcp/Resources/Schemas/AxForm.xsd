    </xs:sequence>
  </xs:complexType>

  <!-- AxFormReferencedDataSource type -->
  <xs:complexType name="AxFormReferencedDataSourceType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Table" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Fields" type="FieldsType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="JoinSource" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="LinkType" type="xs:string" minOccurs="0" maxOccurs="1"/>
