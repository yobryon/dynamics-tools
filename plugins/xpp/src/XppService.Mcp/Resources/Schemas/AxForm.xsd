      <xs:element name="DataField" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataGroup" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataMethod" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataRelationPath" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DataSource" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DateFormat" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DateMonth" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DateSeparator" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DateYear" type="xs:string" minOccurs="0" maxOccurs="1"/>
