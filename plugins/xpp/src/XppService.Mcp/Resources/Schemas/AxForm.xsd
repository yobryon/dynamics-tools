      <xs:element name="DelayActive" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="CrossCompanyAutoQuery" type="YesNoType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AllowDeferredLoad" type="YesNoType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

