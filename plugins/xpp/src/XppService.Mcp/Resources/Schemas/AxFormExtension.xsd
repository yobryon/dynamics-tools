      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="ConfigurationKey" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ControlModifications" type="ControlModificationsType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Controls" type="FormExtensionControlsType" minOccurs="0" maxOccurs="1"/>
