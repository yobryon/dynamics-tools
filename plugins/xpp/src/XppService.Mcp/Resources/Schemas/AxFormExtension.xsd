      <xs:element name="PropertyModifications" type="PropertyModificationsType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- FormExtensionControls container type -->
  <xs:complexType name="FormExtensionControlsType">
    <xs:sequence>
      <xs:element name="AxFormExtensionControl" type="AxFormExtensionControlType" minOccurs="0" maxOccurs="unbounded"/>
