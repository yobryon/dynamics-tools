			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    void init()
    {
        super();

        if(element.args().menuItemName() == "CLIControls_Wizard_NextDisabled")
        {
            CLIControls_Wizard::main(element.args());
            element.closeCancel();
        }
        else if (element.Args().caller())
        {
            sysWizard = element.Args().caller();
        }
        else
        {
            CLIControls_Wizard::main(new Args());
            element.closeCancel();
        }

        if (sysWizard.formRun().lifecycleHelper().lifecycleStage() < FormRunLifecycleStage::Initializing)
        {
            throw error ('The FormRun instance cached in the SysWizard backend class is not updated with the current instance');
        }
    }

]]></Source>
