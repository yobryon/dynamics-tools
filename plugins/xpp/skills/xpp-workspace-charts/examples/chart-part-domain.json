  "sourceCode": {
    "declaration": "[Form]\npublic class MyOrdersByDayChart extends FormRun\n{\n}",
    "methods": [
      {
        "name": "init",
        "source": "    public void init()\n    {\n        super();\n\n        this.populateChartData();\n    }\n"
      },
      {
        "name": "populateChartData",
        "source": "    /// <summary>\n    /// Fills the temp buffer the chart binds to. Re-call after a filter change, then executeQuery().\n    /// </summary>\n    private void populateChartData()\n    {\n        MyOrdersByDayTmp tmp;\n        MyOrderTable      orders;\n        date              fromDate = DateTimeUtil::date(DateTimeUtil::addDays(DateTimeUtil::utcNow(), -7));\n\n        while select OrderDate, count(RecId) from orders\n            group by OrderDate\n            where orders.OrderDate >= fromDate\n        {\n            tmp.OrderDate = orders.OrderDate;\n            tmp.OpenCount = MyOrderTable::countByStatus(orders.OrderDate, MyOrderStatus::Open);\n            tmp.ClosedCount = orders.RecId - tmp.OpenCount;\n            tmp.insert();\n        }\n\n        // A chart with a single row can fail in the client; pad with a zero row when sparse.\n        if (!tmp)\n        {\n            tmp.OrderDate = fromDate;\n            tmp.insert();\n        }\n\n        MyOrdersByDayTmp_ds.setTmpData(tmp);\n        MyOrdersByDayTmp_ds.executeQuery();\n    }\n"
      }
    ]
  }
