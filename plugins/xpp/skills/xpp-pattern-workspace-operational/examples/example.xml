			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        formRunConfigurationUserWorkspace = UserWorkspaceCanvasUtility::validateAndProcessFormArgs(this);

        formRunConfigurationUserWorkspace.reread();
        str caption = formRunConfigurationUserWorkspace.WorkspaceCaption;
        if (formRunConfigurationUserWorkspace.WorkspaceCaptionLabelId != "")
        {
            caption = FormRunConfigurationLabelHelper::getTranslation(formRunConfigurationUserWorkspace.WorkspaceCaptionLabelId, formRunConfigurationUserWorkspace.WorkspaceCaption);
        }
        this.form().design().caption(caption);
        this.dataHelper().Refreshed += eventhandler(this.onRefreshEvent);
        this.configurationHelper().OnPersonalizationSaved += eventhandler(this.onPersonalizationCommand);

        super();
        
        //add a root control group
        rootGroup = this.design().addControl(FormControlType::Group, this.getUniqueControlName(#UserCreatedWorkspaceCenterGroup));
        rootGroup.hideIfEmpty(false);
        rootGroup.widthMode(FormWidth::SizeToAvailable);
        rootGroup.heightMode(FormHeight::SizeToAvailable);
        rootGroup.moveControl(PanoramaTab.id(), 0);

        //
        // This form uses a custom querystring that is required on root navigation (to have an active buffer) 
        // but doesn't align to deep links. This button will not provide a working link.
        //
        FormControl systemDefinedGetALinkButton = this.design().controlName(#SystemDefinedGetALinkButton);
        Debug::assert(systemDefinedGetALinkButton != null);
        if (systemDefinedGetALinkButton)
        {
            systemDefinedGetALinkButton.visible(false);
        }
    }

]]></Source>
