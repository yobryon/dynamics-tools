			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        super();

        this.updateRecordContext();
        element.args().requestContextQuery('');
        for(int i=1; i <= TabbedList.controlCount(); i++)
        {
            FormTabPageControl pageControl = TabbedList.controlNum(i);
            if (pageControl.isVisible())
            {
                pageControl.activatePage();
                break;
            }
        }
    }

]]></Source>
