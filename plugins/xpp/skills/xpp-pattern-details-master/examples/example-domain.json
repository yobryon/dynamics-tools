                      { "name": "MyEntity_MyEntityId1", "kind": "String", "dataSource": "MyEntity", "dataField": "MyEntityId" },
                      { "name": "MyEntity_Name1", "kind": "String", "dataSource": "MyEntity", "dataField": "Name" },
                      { "name": "MyEntity_Description1", "kind": "String", "dataSource": "MyEntity", "dataField": "Description" },
                      { "name": "MyEntity_CreatedDateTime1", "kind": "DateTime", "dataSource": "MyEntity", "dataField": "CreatedDateTime" }
