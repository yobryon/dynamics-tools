                "controls": [
                  { "name": "MyEntity_MyEntityId2", "kind": "String", "dataSource": "MyEntity", "dataField": "MyEntityId" },
                  { "name": "MyEntity_Name2", "kind": "String", "dataSource": "MyEntity", "dataField": "Name" },
                  { "name": "MyEntity_Description2", "kind": "String", "dataSource": "MyEntity", "dataField": "Description" },
                  { "name": "MyEntity_CreatedDateTime2", "kind": "DateTime", "dataSource": "MyEntity", "dataField": "CreatedDateTime" }
                ]
              },
              { "name": "MainGridDefaultAction", "kind": "CommandButton", "command": "DetailsView", "visible": false }
            ]
          }
        ]
      }
    ]
  },
  "sourceCode": {
    "declaration": "[Form]\npublic class MyEntityDetails extends FormRun\n{\n}",
    "dataSources": [
      {
        "name": "MyEntity",
        "methods": [
          {
            "name": "titleFields",
            "source": "    /// <summary>\n    /// Title-strip text. Overrides the FormDataSource base method, so the parameter is Common.\n    /// </summary>\n    public display TitleFields titleFields(Common _record)\n    {\n        MyEntity entity = _record as MyEntity;\n        return strFmt('%1 : %2', entity.MyEntityId, entity.Name);\n    }\n"
          }
        ]
      }
    ]
  }
}
