              "extensionProperties": [
                { "name": "targetControlName", "type": "String", "value": "NavigationListGrid" },
                { "name": "defaultColumnName", "type": "String", "value": "MyEntity_Name" },
                { "name": "placeholderText", "type": "String", "value": "@SYS4160785" }
              ]
            }
          },
          {
            "name": "NavigationListGrid",
            "kind": "Grid",
            "style": "List",
            "dataSource": "MyEntity",
            "otherProperties": { "MultiSelect": "No", "ShowRowLabels": "No" },
            "controls": [
              { "name": "MyEntity_Name", "kind": "String", "dataSource": "MyEntity", "dataField": "Name" },
              { "name": "MyEntity_MyEntityId", "kind": "String", "dataSource": "MyEntity", "dataField": "MyEntityId" }
            ]
          }
        ]
      },
      {
