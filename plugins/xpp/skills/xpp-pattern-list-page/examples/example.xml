						<Source><![CDATA[
        /// <summary>
        /// call SysQuery Form
        /// </summary>
        public void clicked()
        {
            Query query;
            QueryRun queryRun;
            super();
            query = CLI_DescendingSortTest_ds.query();
            queryRun = new QueryRun(query);

            if (queryRun.prompt())
            {
                CLI_DescendingSortTest_ds.query(queryRun.query());
                CLI_DescendingSortTest_ds.executeQuery();
            }
        }

]]></Source>
