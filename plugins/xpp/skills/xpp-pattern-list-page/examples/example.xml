						<Source><![CDATA[
        /// <summary>
        /// create data
        /// </summary>
        public void clicked()
        {
            CLI_DescendingSortTest record;
            super();

            ttsbegin;
            for(int i=1; i <= 200; i++)
            {
                record.clear();
                record.initValue();
                record.TransId = strFmt("AAA-%1", i);
                record.EmpNum = "ABC-0002";
                record.doInsert();
            }
            ttscommit;

            element.dataSource(1).research(false);
        }

]]></Source>
